<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    * {
        font-family: sans-serif;
    }
    
    .content-table {
        border-collapse: collapse;
        margin: 25px 0;
        font-size: 0.9em;
        min-width: 400px;
        border-radius: 5px 5px 0 0;
        overflow: auto;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
        text-align: center;
    }
    
    .content-table thead tr {
        background-color: #009879;
        color: #ffffff;
        /* text-align: center; */
        font-weight: bold;
    }
    
    .content-table th,
    .content-table td {
        padding: 12px 15px;
    }
    
    .content-table tbody tr {
        border-bottom: 1px solid #dddddd;
    }
    
    .content-table tbody tr:nth-of-type(even) {
        background-color: #f3f3f3;
    }
    
    .content-table tbody tr:last-of-type {
        border-bottom: 2px solid #009879;
    }
</style>
<body>
    <center>
        <h1>User Details</h1>
    <br><br>
    <table class="content-table">
        <thead>
            <tr>
                <th width="50px">No</th>
                <th>User Id</th>
                <th>User_uuid</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Display Name</th>
                <th>email Id</th>
                <th>Mobile Number</th>
                <th>Reputations</th>
                <th>is email verify?</th>
                <th>is moderator?</th>
                <th>Profile Image</th>
                <th>createdAt</th>
                <th>updatedAt</th>
                <th>deletedAt</th>
                <th>Skills</th>
            </tr>
        </thead>
        <tbody>
            <% if(userDetails.length){ for(var i=0;i < userDetails.length;i++) { %>
                <tr>
                    <td>
                        <%=(i+1)%>
                    </td>
                    <td>
                        <%=userDetails[i].id%>
                    </td>
                    <td>
                        <%=userDetails[i].uuid%>
                    </td>
                    <td>
                        <%=userDetails[i].first_name%>
                    </td>
                    <td>
                        <%=userDetails[i].last_name%>
                    </td>
                    <td>
                        <%=userDetails[i].display_name%>
                    </td>
                    <td>
                        <%=userDetails[i].email%>
                    </td>
                    <td>
                        <%=userDetails[i].phone_number%>
                    </td>
                    <td>
                        <%=userDetails[i].dataValues.reputations%>
                    </td>
                    <td>
                        <%=userDetails[i].is_email_verified%>
                    </td>
                    <td>
                        <%=userDetails[i].is_moderator%>
                    </td>
                    <td>
                        <% var myLink=userDetails[i].profile_image%>
                            <a href=<%=myLink%>> <%=myLink%></a>
                    </td>
                    <td>
                        <%=userDetails[i].created_at%>
                    </td>
                    <td>
                        <%=userDetails[i].updated_at%>
                    </td>
                    <td>
                        <%=userDetails[i].deleted_at%>
                    </td>
                    <td style="padding: 10px;">
                        <%=userDetails[i].allSkills%>
                    </td>
                </tr>
                <% } }else{ %>
                    <tr>
                        <td colspan="3">No user</td>
                    </tr>
                    <% } %>
        </tbody>
    </table>
</center>
</body>

</html>